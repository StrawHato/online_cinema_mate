[flake8]
max-line-length = 119
max-complexity = 18
inline-quotes = "

select =
    B,
    C,
    E,
    F,
    W,
    T4,
    B9,
    ANN,
    Q0,
    N8,
    VNE

ignore =
    E203,
    E266,
    W503,
    W504,
    F401,
    ANN002,
    ANN003,
    ANN101,
    ANN102,
    ANN401,
    N807,
    N818,
    VNE001

exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .ruff_cache,
    .venv,
    venv,
    build,
    dist

extend-exclude =
    src/tests/*,
    src/database/migrations/*
