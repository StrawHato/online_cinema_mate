# Leave empty to use the same-origin /api/v1 path behind a reverse proxy.
# For local development, Vite proxies /api/v1 to http://localhost:8000.
VITE_API_URL=

# Public URL prefix used to display uploaded avatars in the browser.
# Local MinIO default: http://localhost:9000/online-cinema
VITE_S3_PUBLIC_URL=http://localhost:9000/online-cinema
